            <button class="icon-btn star-btn" onclick="toggleUnderline(this)" title="밑줄">⭐</button>
          </div>
        </div>

        <div class="sentence-row">
          <span class="english-text" onclick="speakEnglish(this)">Marie: Hi, Jenny. Can you see me
